EVIDENCE_MODE=fixture
EVIDENCE_DATA_DIR=/data/evidence
GBIF_BASE_URL=https://api.gbif.org/v1
CORS_ALLOW_ORIGINS=http://localhost:13100,http://127.0.0.1:13100
VITE_API_BASE_URL=http://localhost:18100
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ADMIN_TOKEN=change-this-local-admin-token
ANALYTICS_HASH_SECRET=change-this-analytics-hash-secret

# Public-demo defaults. Require auth and protect run reads for a controlled API deployment.
API_AUTH_REQUIRED=false
API_AUTH_TOKEN=
API_AUTH_PROTECT_RUN_READS=false
API_RATE_LIMIT_READ_PER_MINUTE=240
API_RATE_LIMIT_WRITE_PER_MINUTE=30
API_MAX_REQUEST_BODY_BYTES=12582912
API_MAX_CSV_UPLOAD_BYTES=2097152
API_MAX_REFERENCE_UPLOAD_BYTES=10485760
API_MAX_CONCURRENT_HEAVY_REQUESTS=4
REFERENCE_UPLOADS_ENABLED=true
BARCODE_SEARCH_TIMEOUT_SECONDS=30
MAX_PYTHON_SEARCH_COMPARISONS=50000000
TRUST_PROXY_HEADERS=false

# No default: generate an operator-managed value of at least 32 bytes for trusted scientific attestations.
ECOGENESIS_EVIDENCE_ATTESTATION_SECRET=
ECOGENESIS_EVIDENCE_ATTESTATION_KEY_ID=configured-local-hmac-v1
