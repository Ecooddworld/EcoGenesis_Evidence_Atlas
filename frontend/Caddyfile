{
	admin off
	http_port 8080
	https_port 8443
}

(ecogenesis_app) {
	encode zstd gzip
	root * /srv
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy geolocation=(), microphone=(), camera=()
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob: https://tile.gbif.org https://api.gbif.org; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle /submission-video* {
		try_files {path} {path}/ /submission-video/index.html
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

http://89.167.66.248 {
	redir https://ecooddworld.eu{uri} permanent
}

ecooddworld.eu, www.ecooddworld.eu {
	import ecogenesis_app
}
