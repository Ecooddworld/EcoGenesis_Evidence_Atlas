FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

RUN setcap -r /usr/bin/caddy \
    && addgroup -S -g 10001 ecogenesis \
    && adduser -S -D -H -u 10001 -G ecogenesis ecogenesis \
    && mkdir -p /srv /data /config \
    && chown -R ecogenesis:ecogenesis /srv /data /config

COPY frontend/Caddyfile /etc/caddy/Caddyfile
COPY --chown=ecogenesis:ecogenesis --from=build /app/dist /srv
COPY --chown=ecogenesis:ecogenesis submission-assets/contest-video-v2/video/ecogenesis-gbif-contest-demo-en-subs.mp4 /srv/submission-video/
COPY --chown=ecogenesis:ecogenesis submission-assets/contest-video-v2/video/ecogenesis-gbif-contest-demo-en.srt /srv/submission-video/
COPY --chown=ecogenesis:ecogenesis submission-assets/contest-video-v2/video/ecogenesis-gbif-contest-demo-english-voiceover.txt /srv/submission-video/
COPY --chown=ecogenesis:ecogenesis submission-assets/contest-video-v2/video/ecogenesis-gbif-contest-demo-transcript.md /srv/submission-video/
COPY --chown=ecogenesis:ecogenesis submission-assets/contest-video-v2/video/demo-thumbnail-contest-en.png /srv/submission-video/

USER 10001:10001

EXPOSE 8080 8443
