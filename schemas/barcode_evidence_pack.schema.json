{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Barcode-to-GBIF Evidence Pack",
  "type": "object",
  "required": ["run", "summary", "reference_manifest", "decision_rules", "metrics", "data_accounting_ledger", "scientific_release_gate", "dwca_validation", "records", "exports"],
  "properties": {
    "run": {
      "type": "object",
      "required": ["run_id", "tool", "ruleset_version", "request_fingerprint"],
      "properties": {
        "run_id": { "type": "string" },
        "tool": { "const": "Barcode-to-GBIF Evidence Compiler" },
        "ruleset_version": { "type": "string" },
        "request_fingerprint": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["title", "project_title", "marker", "reference_database", "processed_records", "verdict"],
      "properties": {
        "title": { "const": "Barcode-to-GBIF Evidence Compiler" },
        "project_title": { "type": "string" },
        "marker": { "type": "string" },
        "reference_database": { "type": "string" },
        "processed_records": { "type": "integer" },
        "verdict": { "type": "string" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence_id", "scientific_decision_state", "decision_class", "taxonomic_status", "candidate_taxon", "published_taxon", "publication_status", "publication_stage", "publication_bucket", "export_state", "blockers"],
        "properties": {
          "sequence_id": { "type": "string" },
          "scientific_decision_state": {
            "enum": ["species-rule-pass", "species-level-molecular-candidate-assay-blocked", "genus-safe", "higher-rank-safe", "ambiguous", "weak", "no-match"]
          },
          "decision_class": {
            "enum": ["species-safe", "genus-safe", "higher-rank-safe", "ambiguous", "weak", "no-match", "not-publishable"]
          },
          "taxonomic_status": { "type": "string" },
          "candidate_taxon": { "type": "object" },
          "published_taxon": { "type": "object" },
          "publication_status": {
            "enum": ["candidate-for-gbif-validation", "record-ready", "not-ready"]
          },
          "publication_stage": {
            "enum": ["record_not_ready", "record_min_ready", "record_recommended_ready", "dataset_ready", "gold_ready"]
          },
          "publication_bucket": {
            "enum": ["validation_candidate", "publishable_candidate", "repair_required", "review_only"]
          },
          "export_state": {
            "enum": ["candidate_for_gbif_validation", "dwc_template_ready", "evidence_publishable_repair_required", "review_only", "not_exportable"]
          },
          "safe_taxon": { "type": "object" },
          "reference_completeness": {
            "type": "object",
            "required": ["status", "gate_pass", "trust_status", "evidence_use", "blockers"],
            "properties": {
              "status": { "enum": ["pass", "fail", "missing"] },
              "gate_pass": { "type": "boolean" },
              "trust_status": {
                "enum": ["verified", "unsigned", "missing", "server_verification_not_configured", "server_verification_misconfigured", "unsupported_contract", "purpose_mismatch", "unknown_key", "payload_tampered", "invalid_signature", "invalid_time_window", "issued_in_future", "expired_or_stale_replay"]
              },
              "evidence_use": { "enum": ["scientific_gate_input", "informational_only"] },
              "blockers": { "type": "array", "items": { "type": "string" } }
            }
          },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "scientific_release_gate": {
      "type": "object",
      "required": ["status", "release_eligible", "trust_status", "evidence_use", "blockers"],
      "properties": {
        "status": { "enum": ["pass", "blocked"] },
        "release_eligible": { "type": "boolean" },
        "trust_status": {
          "enum": ["verified", "missing", "unsigned", "server_verification_not_configured", "server_verification_misconfigured", "unsupported_contract", "purpose_mismatch", "unknown_key", "payload_tampered", "invalid_signature", "invalid_time_window", "issued_in_future", "expired_or_stale_replay"]
        },
        "evidence_use": { "enum": ["scientific_gate_input", "informational_only"] },
        "attestation_verification": { "type": "object" },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dwca_validation": {
      "type": "object",
      "required": ["local_validation_status", "release_gate", "external_validation"],
      "properties": {
        "local_validation_status": { "enum": ["pass", "blocked"] },
        "release_gate": { "enum": ["blocked_external_validation", "blocked_local_validation"] },
        "external_validation": { "type": "object" }
      }
    },
    "data_accounting_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "value", "denominator", "unit", "layer", "meaning"],
        "properties": {
          "metric": { "type": "string" },
          "value": {},
          "denominator": {},
          "rate": { "type": ["number", "null"] },
          "unit": { "type": "string" },
          "layer": { "type": "string" },
          "meaning": { "type": "string" }
        }
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": ["string", "null"] }
        }
      }
    }
  }
}
